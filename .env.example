# Copy to .env. Never commit real credentials.
# Required only for video transcription:
XFYUN_APPID=
XFYUN_API_SECRET=

# Required for summarization, query expansion and answering.
# Use a chat-completions model available to your account.
LLM_API_KEY=
LLM_API_URL=https://api.moonshot.cn/v1/chat/completions
LLM_MODEL=

# Required for both document ingestion and knowledge-base retrieval:
DASHSCOPE_API_KEY=

# Optional. Leave FFMPEG_PATH blank to discover FFmpeg automatically.
FFMPEG_PATH=
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860
ENABLE_DOCUMENT_ROUTING=false
# KB_DIR=kb_data
# CACHE_DIR=video_cache
